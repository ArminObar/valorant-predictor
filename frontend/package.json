{
  "name": "vpredict-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "audit:lint": "eslint -c eslint.config.audit.mjs src",
    "audit:render": "esbuild scripts-audit/render-entry.jsx --bundle --format=esm --platform=node --jsx=automatic --alias:chart.js=./scripts-audit/chartStub.mjs --outfile=scripts-audit/render-bundle.mjs --log-level=error && node scripts-audit/render-audit.mjs",
    "audit": "npm run audit:lint && npm run audit:render"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "vite": "^8.1.5"
  }
}
